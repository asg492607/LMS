# Express API configuration (server only). Copy this file to .env.
# Never add the Supabase secret key or database password to a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Direct Supabase Postgres connection, using the restricted lms_backend role.
# The role and grants are created by the LMS migration.
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=lms_backend
SUPABASE_DB_PASSWORD=replace_with_a_long_random_password

API_PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
UNIVERSITY_ID=mit-adt
UNIVERSITY_NAME=MIT ADT University
